# Where the Bongah API (apps/api) is. The panel's server calls it; the browser never does.
BONGAH_API_URL=http://localhost:3000
# The address this panel is served from. Used to refuse cross-site writes (CSRF) and to mark the session cookie Secure.
# In production this MUST be the real https origin, e.g. https://panel.bongah.af
PANEL_ORIGIN=http://localhost:3100
# Map tiles. OpenStreetMap's public server is for light use only (see its tile usage policy): point this at a tile
# service you pay for or host yourself before a public release. The mobile app uses the same variable name.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_MAX_ZOOM=19
