// Bongah — PostgreSQL schema (Prisma 7).
//
// Conventions
//  - Prisma fields are camelCase; database columns/tables are snake_case via @map/@@map.
//  - Primary keys are native `uuid` columns (v4, generated by Prisma).
//  - Timestamps are `timestamptz` (stored in UTC).
//  - Money is NUMERIC(14,2) -> Prisma `Decimal`. Never use Float for money.
//  - Onward/financial records are never cascade-deleted: relations to User/Agency use
//    `Restrict`, so a hard delete of a user or agency with history fails loudly.
//    Use a status/soft-delete for account removal.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection URL lives in prisma.config.ts (Prisma 7).
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  USER
  AGENCY
  ADMIN

  @@map("role")
}

enum PropertyType {
  APARTMENT
  HOUSE_HAWILI
  LAND
  OFFICE_SHOP
  GARDEN_VILLA

  @@map("property_type")
}

enum DealType {
  SALE
  RENT
  MORTGAGE_GROWI

  @@map("deal_type")
}

enum Currency {
  AFGHANI
  USD

  @@map("currency")
}

enum PropertyStatus {
  ACTIVE
  SOLD
  ARCHIVED

  @@map("property_status")
}

enum SubscriptionPackage {
  MONTHLY
  QUARTERLY
  YEARLY

  @@map("subscription_package")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED

  @@map("subscription_status")
}

enum TransactionPurpose {
  SUBSCRIPTION
  LADDER
  FEATURED_AD
  MAP_LOCATION
  CONTACT_CREDITS

  @@map("transaction_purpose")
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED

  @@map("transaction_status")
}

/// How a map location token came to exist. REFERRAL and ADMIN_GRANT have no endpoint yet; the
/// grant helper in src/map-location/map-location.tokens.ts is what a referral module will call.
enum MapLocationTokenSource {
  PURCHASE
  REFERRAL
  ADMIN_GRANT

  @@map("map_location_token_source")
}

/// What a reward is worth. Only LADDER_TOKEN has an effect today (see RewardsService.redeemLadderToken).
/// BONUS_LISTING and SUBSCRIPTION_EXTENSION are reserved so the table does not need a migration
/// the day the product decides how they work; nothing grants or reads them yet.
enum RewardType {
  LADDER_TOKEN
  BONUS_LISTING
  SUBSCRIPTION_EXTENSION

  @@map("reward_type")
}

/// Why a reward was granted. Together with the user and the invited friend it identifies the reward.
enum RewardReason {
  REFERRER_BONUS
  REFEREE_BONUS

  @@map("reward_reason")
}

/// What a chat message carries. TEXT needs `body`, IMAGE needs `image_id`, LOCATION needs lat + lng
/// (CHECK constraint in the migration).
enum MessageType {
  TEXT
  IMAGE
  LOCATION

  @@map("message_type")
}

/// Why a contact reveal was allowed: one of the day's free reveals, one credit, or an account perk
/// (active agency subscription / admin).
enum ContactUnlockMethod {
  FREE_DAILY
  CREDIT
  PERK

  @@map("contact_unlock_method")
}

/// Where a batch of contact credits came from.
enum ContactCreditSource {
  PURCHASE
  REFERRAL
  ADMIN_GRANT

  @@map("contact_credit_source")
}

// ───────────────────────────── Models ─────────────────────────────

model User {
  id          String   @id @default(uuid()) @db.Uuid
  // Store ONE canonical format (E.164, e.g. +93799123456) — the unique constraint
  // only dedupes identical strings, so normalise before writing.
  phoneNumber String   @unique @map("phone_number")
  fullName    String?  @map("full_name")
  role        Role     @default(USER)
  avatar      String?
  /// The code this user shares to invite friends. Filled by the database (generate_referral_code(),
  /// see the referrals migration) so every way of creating a user gets one.
  referralCode String   @unique @default(dbgenerated("generate_referral_code()")) @map("referral_code")
  /// Who invited this user. Set once, at signup, and never changed.
  /// A user cannot refer themselves (CHECK constraint in the migration).
  referredById String?  @map("referred_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  referredBy User?  @relation("Referrals", fields: [referredById], references: [id], onDelete: Restrict)
  referrals  User[] @relation("Referrals")

  agency            Agency?
  properties        Property[]
  transactions      Transaction[]
  mapLocationTokens MapLocationToken[]
  /// Rewards this user received.
  rewards           Reward[]           @relation("RewardRecipient")
  /// Rewards granted to others because this user signed up with their code.
  rewardsEarnedFrom Reward[]           @relation("RewardInvitee")

  // Chat and contact reveals.
  conversationsAsBuyer  Conversation[]     @relation("ConversationBuyer")
  conversationsAsSeller Conversation[]     @relation("ConversationSeller")
  messagesSent          Message[]
  chatImages            ChatImage[]
  chatTemplates         ChatTemplate[]
  /// Numbers this user revealed.
  contactUnlocks        ContactUnlockLog[] @relation("UnlockViewer")
  /// Times this user's number was revealed by others.
  contactUnlocked       ContactUnlockLog[] @relation("UnlockOwner")
  contactCredits        UserCredit[]       @relation("CreditOwner")
  /// Credits granted to others because this user signed up with their code.
  contactCreditsEarnedFrom UserCredit[]    @relation("CreditInvitee")

  @@index([referredById])
  @@map("users")
}

/// A real-estate office ("Rahnamaye Mamelat"). One agency per user account.
model Agency {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  agencyName   String   @map("agency_name")
  licensePhoto String   @map("license_photo")
  address      String
  /// Exact office pin. Null until the agency places it, which needs an active subscription.
  /// lat and lng are both set or both null (CHECK constraint in the migration).
  lat          Float?
  lng          Float?
  description  String?
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  properties    Property[]
  subscriptions Subscription[]
  transactions  Transaction[]
  conversations Conversation[]

  @@map("agencies")
}

model Property {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  agencyId      String?        @map("agency_id") @db.Uuid
  title         String
  description   String
  type          PropertyType
  dealType      DealType       @map("deal_type")
  price         Decimal        @db.Decimal(14, 2)
  currency      Currency
  areaSqm       Float          @map("area_sqm")
  bedrooms      Int?
  bathrooms     Int?
  province      String
  district      String
  /// Neighbourhood (محله / ولسوالی گذر) as free text. Null only on listings created before it existed.
  neighborhood  String?
  address       String
  /// Exact map pin. Null for listings without one: placing a pin needs an active agency
  /// subscription or a map location token (see src/map-location). Both set or both null.
  lat           Float?
  lng           Float?
  images        String[]       @default([])
  status        PropertyStatus @default(ACTIVE)
  isFeatured    Boolean        @default(false) @map("is_featured")
  /// Position in search results (newest first). Set to the creation time when the listing is
  /// created and to now() when the owner pays for a "Ladder" (نردبان) bump, so ordering by
  /// this one column is enough (Prisma cannot ORDER BY COALESCE). Null only on legacy rows.
  ladderedAt    DateTime?      @map("laddered_at") @db.Timestamptz(3)
  /// Paid "featured" promotion: the badge shows while is_featured is true AND this is in the future.
  /// is_featured alone goes stale at expiry, so readers must check both (see toPropertyDto in src/property/property.mapper.ts).
  featuredUntil DateTime?      @map("featured_until") @db.Timestamptz(3)
  /// How many times people other than the owner opened this listing (agency dashboard "total views").
  /// Only ever changed by one raw `view_count = view_count + 1` statement (PropertyService.recordView):
  /// a Prisma update would also move updated_at, which means "the listing was edited".
  viewCount     Int            @default(0) @map("view_count")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  // If an agency is removed its listings stay with their owner.
  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  transactions     Transaction[]
  mapLocationToken MapLocationToken?
  rewards          Reward[]
  conversations    Conversation[]
  contactUnlocks   ContactUnlockLog[]

  // Postgres does not index foreign keys automatically.
  @@index([userId, createdAt]) // "1 free listing per month" quota check
  @@index([agencyId])
  @@index([status, province, district]) // main browse filter
  @@index([lat, lng]) // map bounding-box search (PostGIS later, see README note)
  @@map("properties")
}

model Subscription {
  id            String              @id @default(uuid()) @db.Uuid
  agencyId      String              @map("agency_id") @db.Uuid
  packageType   SubscriptionPackage @map("package_type")
  startDate     DateTime            @map("start_date") @db.Timestamptz(3)
  endDate       DateTime            @map("end_date") @db.Timestamptz(3)
  status        SubscriptionStatus  @default(ACTIVE)
  /// The payment that bought this subscription (null for admin grants / free trials).
  /// UNIQUE: one payment can never create two subscriptions, whatever the application does.
  transactionId String?             @unique @map("transaction_id") @db.Uuid

  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([agencyId, status, endDate])
  @@map("subscriptions")
}

/// One row per HesabPay payment attempt.
model Transaction {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  amount       Decimal            @db.Decimal(14, 2)
  currency     String
  hesabpayTxId String             @unique @map("hesabpay_tx_id")
  purpose      TransactionPurpose
  status       TransactionStatus  @default(PENDING)

  // What is being paid for, recorded at initiation. The webhook reads this to fulfil the order,
  // so a payment confirmation never has to be trusted for anything but "paid / not paid".
  /// SUBSCRIPTION: the agency and package being bought.
  agencyId    String?              @map("agency_id") @db.Uuid
  packageType SubscriptionPackage? @map("package_type")
  /// LADDER / FEATURED_AD: the listing being promoted.
  propertyId  String?              @map("property_id") @db.Uuid
  /// CONTACT_CREDITS: how many credits this payment buys. Recorded at initiation so a later price
  /// or pack-size change cannot make the buyer receive something other than what they were quoted.
  quantity    Int?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  agency       Agency?       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  property     Property?     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  subscription Subscription?
  /// MAP_LOCATION: the token this payment bought.
  mapLocationToken MapLocationToken?
  /// CONTACT_CREDITS: the credits this payment bought.
  userCredit       UserCredit?

  @@index([userId, createdAt])
  @@index([agencyId])
  @@index([propertyId])
  @@map("transactions")
}

/// A prepaid right to put ONE exact map pin on ONE listing, for users who are not on an agency
/// subscription. Spent (consumed_at + property_id set together) when a listing gets its pin.
/// Moving the pin of a listing that already has one costs nothing.
model MapLocationToken {
  id            String                 @id @default(uuid()) @db.Uuid
  userId        String                 @map("user_id") @db.Uuid
  source        MapLocationTokenSource
  /// The payment that bought it (PURCHASE only). UNIQUE: one payment can never mint two tokens.
  transactionId String?                @unique @map("transaction_id") @db.Uuid
  /// The listing it was spent on. UNIQUE: a listing can never consume two tokens.
  propertyId    String?                @unique @map("property_id") @db.Uuid
  consumedAt    DateTime?              @map("consumed_at") @db.Timestamptz(3)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  property    Property?    @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  // "How many unspent tokens does this user have" and "take the oldest one".
  @@index([userId, consumedAt])
  @@map("map_location_tokens")
}

/// Something a user earned by inviting a friend (or by being invited).
///
/// Granted at signup, in the same transaction that creates the invited user. UNIQUE on
/// (recipient, type, reason, invitee): replaying a signup can never pay the same reward twice.
/// A LADDER_TOKEN is spent by laddering one of the owner's listings; consumed_at and property_id
/// are then set together (CHECK constraint in the migration), like map_location_tokens.
model Reward {
  id             String       @id @default(uuid()) @db.Uuid
  /// Who receives the reward.
  userId         String       @map("user_id") @db.Uuid
  type           RewardType
  reason         RewardReason
  /// The invited friend whose signup earned it. For REFEREE_BONUS this is the recipient themself.
  inviteeId      String       @map("invitee_id") @db.Uuid
  /// How many units: one ladder token, N bonus listings, N days of subscription.
  amount         Int          @default(1)
  /// When it was spent (LADDER_TOKEN only; the reserved types are never "spent" yet).
  consumedAt     DateTime?    @map("consumed_at") @db.Timestamptz(3)
  /// The listing a LADDER_TOKEN was spent on.
  propertyId     String?      @map("property_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User      @relation("RewardRecipient", fields: [userId], references: [id], onDelete: Restrict)
  invitee  User      @relation("RewardInvitee", fields: [inviteeId], references: [id], onDelete: Restrict)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([userId, type, reason, inviteeId])
  // "How many unspent tokens does this user have" and "take the oldest one".
  @@index([userId, type, consumedAt])
  @@index([inviteeId])
  @@index([propertyId])
  @@map("rewards")
}

/// A chat between one buyer and the owner of one listing (a regular user, or the agency's account).
/// One per (listing, buyer): opening "Chat in App" twice reuses it. `seller_id` is the listing's
/// owner at the time; `agency_id` is set when the listing belongs to an agency. It has no row in
/// the conversation list until the first message (`last_message_at`).
model Conversation {
  id              String    @id @default(uuid()) @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  buyerId         String    @map("buyer_id") @db.Uuid
  sellerId        String    @map("seller_id") @db.Uuid
  agencyId        String?   @map("agency_id") @db.Uuid
  /// Set (once, atomically) when the seller's auto-reply was sent. Null = not sent yet.
  autoReplySentAt DateTime? @map("auto_reply_sent_at") @db.Timestamptz(3)
  /// Newest message time; null while the conversation is empty. Orders the conversation list.
  lastMessageAt   DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  buyer    User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller   User      @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  agency   Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([propertyId, buyerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@map("conversations")
}

/// One chat message. Which fields are filled depends on `type` (CHECK constraint in the migration).
/// `client_id` is made by the sender's device: sending the same message twice (a retry after a
/// dropped connection) stores it once.
model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  type           MessageType
  body           String?
  imageId        String?     @unique @map("image_id") @db.Uuid
  lat            Float?
  lng            Float?
  /// Sent automatically from the seller's auto-reply template, not typed by them.
  isAutoReply    Boolean     @default(false) @map("is_auto_reply")
  clientId       String      @map("client_id") @db.Uuid
  /// When the OTHER participant saw it. Null = unread.
  readAt         DateTime?   @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  image        ChatImage?   @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@unique([conversationId, senderId, clientId])
  @@index([conversationId, createdAt, id]) // history, newest first
  @@index([conversationId, readAt]) // unread counts
  @@map("messages")
}

/// An uploaded chat picture. The bytes live in the chat image store (disk now; see
/// src/chat/images/); this row says who uploaded it and, once sent, which message carries it.
/// Only the uploader (before it is sent) and the two people in the conversation may download it.
model ChatImage {
  id          String   @id @default(uuid()) @db.Uuid
  uploaderId  String   @map("uploader_id") @db.Uuid
  contentType String   @map("content_type")
  byteSize    Int      @map("byte_size")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  message  Message?

  @@index([uploaderId, createdAt])
  @@map("chat_images")
}

/// A saved reply an agency can send with one tap. At most one per user is the AUTO reply, sent by
/// itself to a buyer's first message (partial UNIQUE index in the migration). Creating and using
/// templates needs the agency perks (active subscription).
model ChatTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  body        String
  isAutoReply Boolean  @default(false) @map("is_auto_reply")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("chat_templates")
}

/// One revealed phone number: this user may see (and call / WhatsApp) `contact_user_id`'s number for
/// the Kabul calendar day `day_key`. UNIQUE per (viewer, number, day): revealing the same number
/// again the same day is free and does not count again, and one reveal covers phone and WhatsApp
/// and every listing of that person.
model ContactUnlockLog {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  contactUserId String              @map("contact_user_id") @db.Uuid
  /// The listing it was revealed from (for analytics and the pre-filled WhatsApp text).
  propertyId    String              @map("property_id") @db.Uuid
  /// The Kabul-local date (UTC+4:30) the reveal counts for.
  dayKey        DateTime            @map("day_key") @db.Date
  method        ContactUnlockMethod
  /// The credit batch that paid for it (method CREDIT only; CHECK constraint in the migration).
  creditId      String?             @map("credit_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User        @relation("UnlockViewer", fields: [userId], references: [id], onDelete: Restrict)
  contactUser User        @relation("UnlockOwner", fields: [contactUserId], references: [id], onDelete: Restrict)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  credit      UserCredit? @relation(fields: [creditId], references: [id], onDelete: Restrict)

  @@unique([userId, contactUserId, dayKey])
  @@index([userId, dayKey, method]) // "how many free reveals did I use today"
  @@index([propertyId])
  @@map("contact_unlock_logs")
}

/// A batch of contact reveal credits. `remaining` counts down as reveals are paid for; the oldest
/// batch with credits left is used first. Credits never expire. The balance is the SUM of `remaining`.
///
/// Whether an agency currently has unlimited reveals is NOT stored here: it follows from its
/// subscription rows (see src/perks), so there is no second copy that could drift from them.
model UserCredit {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  source        ContactCreditSource
  amount        Int
  remaining     Int
  /// The payment that bought them (PURCHASE only). UNIQUE: one payment can never mint two batches.
  transactionId String?             @unique @map("transaction_id") @db.Uuid
  /// REFERRAL only: the invited friend whose signup earned these. One batch per (user, friend)
  /// (partial UNIQUE index in the migration).
  inviteeId     String?             @map("invitee_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User         @relation("CreditOwner", fields: [userId], references: [id], onDelete: Restrict)
  invitee     User?        @relation("CreditInvitee", fields: [inviteeId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  unlocks     ContactUnlockLog[]

  @@index([userId, remaining])
  @@map("user_credits")
}

/// A phone-login one-time passcode. Only a keyed hash of the code is stored, never the code.
/// Deliberately has no relation to User: the user may not exist until the first successful login.
model OtpCode {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String    @map("phone_number") // canonical +93… form
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Verification attempts used; the code is dead after the limit is reached.
  attempts    Int       @default(0)
  /// Set when the code is used, or replaced by a newer one. Single use.
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneNumber, createdAt])
  @@map("otp_codes")
}
