PORT=3000

# PostgreSQL (Prisma)
# DATABASE_URL is what the running API uses; DIRECT_URL is what `prisma migrate` uses (prisma.config.ts).
# Local: both can be the same address.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bongah
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/bongah
# Supabase (percent-encode special characters in the password):
#   DATABASE_URL = transaction pooler, port 6543:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DIRECT_URL = session pooler, port 5432 (works on IPv4 networks; the db.<project-ref>.supabase.co host is IPv6-only):
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Connection pool (all optional; the defaults suit a hosted database such as Supabase). Idle connections are kept for
# minutes because opening a new one over a long round trip takes longer than Prisma's 2 s default wait, which shows up
# as P2028 "Unable to start a transaction in the given time".
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=300000
# DB_CONNECT_TIMEOUT_MS=15000
# DB_TRANSACTION_MAX_WAIT_MS=10000
# How often to retry when OPENING a connection fails with a network error ("Connection terminated due to connection
# timeout"); and how often (ms) a trivial query keeps one connection warm (0 = off).
# DB_CONNECT_RETRIES=2
# DB_KEEPALIVE_INTERVAL_MS=60000

# Auth (OTP + JWT)
# Required, 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800
# How the 6-digit sign-in code reaches the user.
#   whatsapp: sent to the user's WhatsApp through the WhatsApp Business Cloud API (needs the WHATSAPP_* settings below).
#   mock:     printed to the server log instead. In production it must be set explicitly and logs a warning at startup:
#             testing deployments only, real users would never receive a code.
# (SMS_PROVIDER, the old name of this setting, is still read when OTP_PROVIDER is not set.)
OTP_PROVIDER=mock
# When the WhatsApp gateway fails to deliver a code, hand the code back in the response (the app shows it in a
# toast / pre-fills it) so sign-in is never blocked. Default: on everywhere except NODE_ENV=production, where it
# stays off on purpose - on a live server it would let anyone who can make the gateway fail sign in as any number.
# OTP_DEV_FALLBACK=true
# WhatsApp Cloud API (only read when OTP_PROVIDER=whatsapp). Create these in the Meta Business dashboard:
#   WHATSAPP_ACCESS_TOKEN     a permanent system-user token with the whatsapp_business_messaging permission. Keep it secret.
#   WHATSAPP_PHONE_NUMBER_ID  the numeric "Phone number ID" of the sending number (not the phone number itself).
#   WHATSAPP_TEMPLATE_NAME    an APPROVED authentication-category template whose body takes the code as {{1}} and which has
#                             a "copy code" button. WhatsApp cannot start a conversation without one.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=fa
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TIMEOUT_MS=8000
# Optional: run `pnpm test:e2e` against a separate database instead of DATABASE_URL
# TEST_DATABASE_URL=

# Payments (HesabPay)
# "mock": no network; the webhook is HMAC-SHA256 signed with HESABPAY_WEBHOOK_SECRET (development/tests/staging only,
#         logs a warning in production). "live": talks to HesabPay, and without HESABPAY_API_KEY falls back to
#         mock with a warning. In production without HESABPAY_WEBHOOK_SECRET a random one is used (webhook closed). The live adapter is UNVERIFIED, see
#         src/hesabpay/gateway/live-hesabpay.gateway.ts before using it.
# "manual": real money WITHOUT a payment provider. The customer is shown the accounts below (nothing opens, no redirect),
#         sends the money from the HesabPay app or card-to-card, uploads a picture of the receipt, and an admin
#         approves it in the web panel (Payments page). The prices below must be set, like in live mode.
HESABPAY_MODE=mock
# Test checkout (mock mode only, ignored in live): "true" settles every purchase the moment it is started, through the
# same delivery a real webhook uses (plan, credits, receipt). Nobody is charged. Leave it unset for real payments.
HESABPAY_MOCK_AUTO_SUCCESS=false
HESABPAY_BASE_URL=https://api.hesab.com/api/v1
HESABPAY_API_KEY=
# Mock mode only, 16+ characters: the key used to sign mock webhooks.
HESABPAY_WEBHOOK_SECRET=
# Manual mode only: where customers send the money. Set a HesabPay wallet, a card, or both (a number needs its holder).
MANUAL_PAY_HESABPAY_PHONE=+93785185336
MANUAL_PAY_HESABPAY_HOLDER=Rahman Rezaee
# MANUAL_PAY_CARD_NUMBER=
# MANUAL_PAY_CARD_HOLDER=
# MANUAL_PAY_CARD_BANK=
# One extra line shown with the accounts (when payments are checked, a support number). At most 300 characters.
# MANUAL_PAY_NOTE=
# Largest receipt picture, in bytes (default 5000000). Pictures are kept under UPLOAD_DIR/payment-proofs, which is
# private: only admins can read them. Like the chat pictures, that folder needs a persistent disk in production.
# MANUAL_PAY_PROOF_MAX_BYTES=5000000
# Currency of every price below: AFGHANI or USD
HESABPAY_CURRENCY=AFGHANI
# Prices are decided here, never by the client. Mock mode falls back to placeholder prices;
# live mode (with an API key) refuses to start unless the single prices below are set.
# Agency subscriptions are NOT priced one by one: they all come from one monthly list price (default 1000, for up to
# 10 listings a month) with 10% / 20% / 35% / 50% off for 1 / 3 / 6 / 12 months. The old per-plan lines
# HESABPAY_PRICE_SUBSCRIPTION_{MONTHLY,QUARTERLY,SEMIANNUAL,YEARLY} are ignored (a warning is logged at startup if set),
# so delete them from your .env. To change the base price (the admin panel's price overrides still win over it):
# HESABPAY_PRICE_SUBSCRIPTION_LIST_MONTHLY=1000
HESABPAY_PRICE_LADDER=
# One featured ad for HESABPAY_FEATURED_AD_DAYS days (100 by default). Bundles of 3, 5, 10 and 20 are 10%, 20%, 35% and 45% cheaper (270, 400, 650 and 1100 at 100).
HESABPAY_PRICE_FEATURED_AD=
# One pack of contact reveal credits and how many credits it holds (a person gets 3 free phone-number
# reveals per day; credits pay for more). Mock mode has placeholders; live mode needs both.
HESABPAY_PRICE_CONTACT_CREDITS=
HESABPAY_CONTACT_CREDITS_PER_PACK=
# One exact map pin on one listing (the "Map Location add-on"). Agencies with an active subscription never pay it.
HESABPAY_PRICE_MAP_LOCATION=
# How long a paid featured badge lasts (whole days)
HESABPAY_FEATURED_AD_DAYS=

# Agency free trial: a new agency can publish listings (one by one or in bulk) without a subscription for this many
# days and up to this many listings, whichever ends first. Placeholder business numbers: 30 days and 10 listings.
# 0 days switches trials off for agencies that register from now on. Contact reveals, chat tools and the office pin
# still need a subscription.
# AGENCY_TRIAL_DAYS=30
# AGENCY_TRIAL_LISTINGS=10

# Referrals
# How many invited friends can earn one person a free ladder token (the friend always gets theirs).
# Placeholder business decision: defaults to 20. 0 turns inviter rewards off.
REFERRAL_MAX_REWARDED_INVITES=20
# Contact reveal credits each side of a referral earns (the new user always, the inviter within the cap).
# Undecided business choice: 0 (the default) means referrals earn only ladder tokens.
REFERRAL_CONTACT_CREDITS=0
# The invite link people share, with {code} where the referral code goes, e.g. https://example.af/invite/{code}
# Leave empty until a landing page or deep link exists: the app then shares the code alone.
REFERRAL_LINK_TEMPLATE=

# Contact reveals and chat
# Phone numbers a regular account may reveal per day (Kabul time) without paying. Agencies with a
# subscription are unlimited.
CONTACT_DAILY_FREE_LIMIT=3
# Chat pictures. A regular account may send pictures up to CHAT_IMAGE_MAX_BYTES; agencies with a
# subscription get the larger CHAT_IMAGE_MAX_BYTES_ADVANCED ("high-quality photos"). Only the size differs:
# the server does not re-encode or inspect the picture beyond checking it is a real JPEG/PNG/WebP.
CHAT_IMAGE_MAX_BYTES=1500000
CHAT_IMAGE_MAX_BYTES_ADVANCED=8000000
# Messages one account may send per minute.
CHAT_MESSAGES_PER_MINUTE=30
# Where chat pictures are stored on this server's disk. Without it production falls back to the temp folder with a
# warning (pictures are lost on restart). Production should use object storage instead (see ChatImageStorage in src/chat/images): a disk is lost with the machine.
UPLOAD_DIR=

# Listing photos (agencies upload them from the app and the web panel)
# The address the API is reached at from outside, no trailing slash. Photo links stored in listings are built
# from it, so changing it later breaks every existing photo link. Without it production uses RENDER_EXTERNAL_URL
# (set by Render) or localhost, with a warning.
PUBLIC_API_URL=
# The largest photo a regular account may upload, and the larger one agencies with a subscription get
# ("high-resolution photos"). The server checks the file is a real JPEG/PNG/WebP; it does not re-encode it.
PROPERTY_IMAGE_MAX_BYTES=3000000
PROPERTY_IMAGE_MAX_BYTES_ADVANCED=15000000
# How many uploaded photos an account may keep (delete the ones no listing uses to make room).
PROPERTY_IMAGE_MAX_PER_ACCOUNT=100
PROPERTY_IMAGE_MAX_PER_ACCOUNT_ADVANCED=5000
# (Photos are stored in UPLOAD_DIR above, next to chat pictures. Same warning: use object storage in production.)

# Web panels (admin and agency dashboards)
# Comma-separated origins that may call the API from a browser, e.g.
# https://admin.bongah.example,https://agency.bongah.example (no paths, no wildcards). Empty: no browser access.
CORS_ORIGINS=

# Which proxies' X-Forwarded-For header the API believes (Express "trust proxy"). The rate limits are per client address:
# behind a reverse proxy, or the agency web panel's server (apps/web), every request would otherwise look like it came
# from that one machine and all users would share a single limit. Leave empty when the API is reached directly.
#   a number = proxies in front of the API (1 for one reverse proxy), or addresses/ranges that may set the header
#   ("loopback", "10.0.0.0/8", "127.0.0.1, 10.0.0.5"). "true" is refused: it would trust every caller.
TRUST_PROXY=

# Push notifications (the 08:00 morning quote)
# mock: nothing is sent, pushes are only recorded in memory (development and testing; logs a warning in production).
# fcm:  Firebase Cloud Messaging. The default in production. Without FCM_SERVICE_ACCOUNT_JSON it falls back to mock
#       with a startup warning (staging/testing); a key that is set but broken still fails the startup.
# off:  the API runs but never pushes (production without Firebase set up yet).
PUSH_PROVIDER=mock
# The Firebase service-account key (Firebase console > Project settings > Service accounts > Generate new private key).
# Either the JSON file's contents or base64 of it (base64 survives dashboards that mangle quotes and newlines).
# Needed when PUSH_PROVIDER=fcm. Keep it secret: anyone with it can push to every phone.
FCM_SERVICE_ACCOUNT_JSON=
# The daily push runs inside the API process every 10 minutes from 08:00 to 10:50 Kabul time; each user is reserved
# once per day, so several servers can all leave it on. Set false to stop it on one server.
SCHEDULER_ENABLED=true

# Place search, "what is here" and driving routes (GET /geo/*, used by the listing form and in-app navigation)
# The keys stay on the server; the app never sees them. With neither set, /geo answers 503 and the app asks
# OpenStreetMap (Nominatim, OSRM) itself, which knows far fewer Afghan shops, cafes and landmarks.
# Google Maps Platform key with Places API (New), Geocoding API and Routes API enabled. Restrict it to those APIs
# and to this server's IP in the Google Cloud console.
GOOGLE_MAPS_API_KEY=
# Mapbox secret or public token with the Search Box, Geocoding and Directions APIs.
MAPBOX_ACCESS_TOKEN=
# Optional order, comma-separated ("mapbox,google"). Left out: every configured one, Google first.
GEO_PROVIDERS=
# How long one provider may take before the next is asked (milliseconds, 1000-30000).
GEO_TIMEOUT_MS=6000
