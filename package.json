{
  "name": "bongah",
  "private": true,
  "version": "1.1.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "packages": "pnpm --filter \"./packages/*\" --parallel run dev",
    "api": "pnpm --filter @bongah/api run start:dev",
    "web": "pnpm --filter @bongah/web run dev",
    "mobile": "pnpm --filter @bongah/mobile run start",
    "android": "pnpm --filter @bongah/mobile run android",
    "ios": "pnpm --filter @bongah/mobile run ios",
    "db:generate": "pnpm --filter @bongah/api run db:generate",
    "db:migrate": "pnpm --filter @bongah/api run db:migrate",
    "db:deploy": "pnpm --filter @bongah/api run db:deploy"
  }
}
